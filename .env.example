# ==============================================================================
# Creative English Spoken Center - Environment Configuration
# ==============================================================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://creativeenglishambikapur.com

# 1. Google Sheets Integration (Lead Collection)
# Deploy your Google Apps Script as a Web App (Access: Anyone) and paste the URL here.
# If omitted, leads will be logged safely to server console without error.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# 2. Resend Email Notifications (Optional)
# Get a free API key at https://resend.com to receive instant email notifications for new leads.
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_EMAIL=creativeenglishambikapur@gmail.com

# 3. Analytics Tracking (Optional)
# Enter your Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Enter your Meta (Facebook) Pixel ID (e.g., 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=
